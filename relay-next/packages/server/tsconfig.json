{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true
  },
  "grats": {
    "graphqlSchema": "./schema.graphql",
    "tsSchema": "./src/__generated__/schema.ts",
    "nullableByDefault": true,
    "strictSemanticNullability": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
